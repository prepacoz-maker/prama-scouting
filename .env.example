# Database PostgreSQL (in produzione: regione UE, connessione TLS)
DATABASE_URL="postgresql://prama:prama@localhost:5432/prama_scouting?schema=public"

# Auth: generare con `openssl rand -base64 32`
NEXTAUTH_SECRET="sostituire-con-una-stringa-casuale-lunga"
NEXTAUTH_URL="http://localhost:3000"

# Media: cartella locale e chiave di cifratura AES-256 (32 byte in base64: `openssl rand -base64 32`)
MEDIA_DIR="./storage"
MEDIA_ENCRYPTION_KEY="sostituire-con-32-byte-in-base64"
MEDIA_MAX_MB="200"

# Password iniziale degli utenti creati dal seed (solo sviluppo)
SEED_PASSWORD="Prama-demo-2026"
